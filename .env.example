# Discord bot token (Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=
# Your server ID; slash commands are registered here so they appear instantly
GUILD_ID=
# Owner password for signing in on your LAN. Change it later in Settings.
# Leave blank to have one generated and printed once to the container log.
ADMIN_PASSWORD=
# self-signed (default) | files (TLS_CERT_FILE/TLS_KEY_FILE) | off (behind an HTTPS reverse proxy)
WEB_TLS=self-signed
WEB_PORT=8443
# Number of nightly backups to keep
BACKUP_KEEP=14

# --- Public access through a Cloudflare Tunnel (optional, see README) ---
# The address people open, e.g. https://nyerk.example.com
PUBLIC_URL=
# Discord Developer Portal > your app > OAuth2: Client ID and Client Secret
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Your Discord user ID (full access). Several: comma separated
OWNER_IDS=
# Role IDs whose members get admin access. Several: comma separated
ADMIN_ROLE_IDS=
# Owner password sign-in: lan (default, not through Cloudflare) | on | off
PASSWORD_LOGIN=lan
# Start the tunnel container and give it its token (Cloudflare Zero Trust > Tunnels)
COMPOSE_PROFILES=
TUNNEL_TOKEN=
# Stop publishing the web port to your LAN: 127.0.0.1:8443 (this machine only)
WEB_BIND=8443
# Address range for the stack's network (change only if it clashes)
NYERK_SUBNET=172.30.70.0/24
