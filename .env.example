# Discord bot token (Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=
# Your server ID; slash commands are registered here so they appear instantly
GUILD_ID=
# Admin password set on first start. Change it later in Settings.
# Leave blank to have one generated and printed once to the container log.
ADMIN_PASSWORD=
# self-signed (default) | files (TLS_CERT_FILE/TLS_KEY_FILE) | off (behind an HTTPS reverse proxy)
WEB_TLS=self-signed
WEB_PORT=8443
# Number of nightly backups to keep
BACKUP_KEEP=14
